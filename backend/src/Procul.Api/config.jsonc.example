{
  // Procul backend configuration — the single source of truth.
  // Secrets are NOT stored here: reference environment variables as ${VAR}; the process
  // environment (populated from `.env` by DotNetEnv) resolves them at startup. An unresolved
  // reference is fatal and names the variable.
  "$schema": "./config.schema.json",

  "server": {
    // Browser origins allowed to call the API. [] in Development = any origin (dev only).
    // There is no wildcard outside Development; a `*` or malformed value fails startup.
    "corsAllowedOrigins": [],
    "sessionLifetime": "30d"
  },

  "database": {
    "connectionString": "${DB_CONNECTION_STRING}"
  },

  "attachments": {
    "storage": "postgres",            // "postgres" | "s3"
    "maxFileSizeBytes": 20971520,     // 20 MiB
    "allowedContentTypes": ["image/*", "text/*", "application/pdf", "audio/mpeg", "audio/wav"],
    "resendHistory": true,            // true = earlier turns re-send the bytes; false = note only
    "textInlineMaxBytes": 262144,     // cap for inlining a text/* file into the prompt (256 KiB)
    "retention": "14d",               // media age limit: orphans deleted, referenced bytes purged; "0" = keep forever
    "s3": {
      "bucket": "${S3_BUCKET}",
      "region": "${S3_REGION}",
      "serviceUrl": "${S3_ENDPOINT}", // set for MinIO / S3-compatible; omit for AWS
      "forcePathStyle": true,
      "accessKey": "${S3_ACCESS_KEY}",
      "secretKey": "${S3_SECRET_KEY}"
    }
  },

  "models": [
    {
      "slug": "openrouter/free",       // also the provider model id sent on the wire
      "name": "Free models",
      "description": "Free models from OpenRouter",
      "apiKey": "${OPENROUTER_KEY}",
      "baseUrl": "https://openrouter.ai/api/v1",
      "provider": "openrouter",        // optional; auto-detected from baseUrl otherwise
      "capabilities": ["text", "image"], // optional; discovered when omitted
      "default": true,
      "healthCheck": true,
      "discoverCapabilities": true,
      "maxOutputTokens": 4096
    }
  ],

  "titleModel": "openrouter/free",     // optional; defaults to the conversation's model

  "imageGeneration": {
    // The generate_image tool (OpenRouter Image API or an OpenAI-compatible images endpoint).
    "enabled": false,                  // when false the tool is not offered to the model
    "provider": "openrouter",          // "openrouter" | "openai-compatible"
    "baseUrl": "https://openrouter.ai/api/v1",
    "apiKey": "${OPENROUTER_KEY}",     // ${VAR}; never returned
    "model": "google/gemini-2.5-flash-image", // an image-output model
    "defaultSize": "1024x1024",
    "defaultAspectRatio": "1:1",
    "maxReferenceImages": 4,
    "timeout": "120s",
    "retention": "14d"                 // generated/shown image age limit; omit to inherit attachments.retention
  },

  "modelHealth": {
    "enabled": true,
    "interval": "30m",                 // idle re-probe cadence (see Part E)
    "timeout": "10s",
    "probePrompt": "Reply with the single word: alive",
    "maxOutputTokens": 5
  },

  "mcp": { "enabled": true, "connectTimeout": "15s", "healthInterval": "60s" },

  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer ${GITHUB_MCP_TOKEN}" }
    }
  }
}
