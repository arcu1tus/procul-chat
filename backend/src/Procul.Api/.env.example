# ---------------------------------------------------------------------------
# Procul backend secrets
# ---------------------------------------------------------------------------
# `config.jsonc` is the single source of truth for the backend (see config.jsonc.example).
# This file holds ONLY secrets. Reference these variables from config.jsonc as ${VAR};
# an unresolved reference fails startup and names the missing variable.

# Shared password protecting the entire API. Required: the app fails to start if it is unset.
# The client exchanges it for an expiring session token via POST /v1/auth/session.
# Use a strong, random value, e.g. `openssl rand -base64 32`.
PROCUL_API_PASSWORD=

# Postgres connection string, referenced from config.jsonc as ${DB_CONNECTION_STRING}.
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=procul;Username=postgres;Password=postgres

# OpenRouter API key, referenced from config.jsonc as ${OPENROUTER_KEY}.
OPENROUTER_KEY=sk-or-v1-replace-me

# ---------------------------------------------------------------------------
# Optional: S3-compatible attachment storage (when attachments.storage is "s3")
# ---------------------------------------------------------------------------
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=          # set for MinIO / S3-compatible; omit for AWS
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# Optional: MCP server tokens
# ---------------------------------------------------------------------------
# Tokens referenced from config.jsonc as ${VAR} live here (never in the JSON).
# The GitHub example server expects a token with access to the MCP endpoint:
# GITHUB_MCP_TOKEN=
