ConnectionStrings__ChatContext=Host=localhost;Port=5432;Database=procul;Username=postgres;Password=postgres

OPENROUTER_API_KEY=sk-or-v1-haha
OPENROUTER_MODEL_SLUG=nvidia/nemotron-3-ultra-550b-a55b:free

# Comma-separated browser origins allowed to call the API.
#
# Development: leave unset to allow any origin (needed for `flutter run -d chrome`,
# whose dev-server port is ephemeral).
# Production and every other environment: there is no wildcard, so you MUST set this to
# the frontend's real origin(s) or all cross-origin browser requests are blocked, e.g.
#   CORS_ALLOWED_ORIGINS=https://app.example.com
# A wildcard (`*`) or a malformed value makes startup fail fast.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Shared password protecting the entire API. Required: the app fails to start if it is unset.
# The client exchanges it for an expiring session token via POST /v1/auth/session.
# Use a strong, random value, e.g. `openssl rand -base64 32`.
PROCUL_API_PASSWORD=

# How long an issued session token stays valid. Optional; defaults to 30d.
# Accepts one or more `<number><unit>` segments with unit d/h/m/s, e.g. 12h or 1h30m.
# Changing PROCUL_API_PASSWORD invalidates every existing token immediately.
# PROCUL_SESSION_LIFETIME=30d